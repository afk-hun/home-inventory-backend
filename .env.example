PORT=3000

MONGODB_URI=mongodb://username:password@domain:27017/home-inventory?authSource=admin

# Secret key used for signing JWTs. Generate a strong random value, for example:  
# Generate using: openssl rand -base64 32  
JWT_SECRET=change_me_to_a_secure_random_value  

# Allowed origin for CORS (frontend URL), e.g. your local dev or production domain.  
# Examples: http://localhost:5173 or https://yourdomain.com  
CORS_ORIGIN=http://localhost:5173  

# Express trust proxy setting for deployments behind reverse proxies/load balancers.
# false: direct connection (local dev)
# true: trust first proxy
# 1,2,...: trust that many proxy hops
# loopback/linklocal/uniquelocal or comma-separated IP/subnet values are also supported by Express.
TRUST_PROXY=false